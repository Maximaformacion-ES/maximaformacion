# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/docs

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel
.vercel-*.env

# typescript
*.tsbuildinfo
next-env.d.ts

# Ops scripts kept local — one-off migrations, GDPR erasure, manual
# data fixes. They reference real emails and prod table names and
# don't need to be tracked. The files live on disk for whoever runs
# them; new entries belong in this directory but not in git.
/scripts

# claude-mem auto-generated per-directory context files. Ignore every
# nested CLAUDE.md but keep the root one (the real project doc).
CLAUDE.md
!/CLAUDE.md
